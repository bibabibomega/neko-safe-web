---
import { PRODUCTS } from '../data/products';
import { T, pathFor } from '../i18n/content';
import type { Locale } from '../data/site';
const { locale, limit } = Astro.props as { locale: Locale; limit?: number };
const c = T[locale].products;
const list = limit ? PRODUCTS.slice(0, limit) : PRODUCTS;
const fmt = new Intl.NumberFormat(locale === 'vi' ? 'vi-VN' : 'en-US');
---
<div class="grid">
  {list.map((p) => (
    <article class="card">
      <img src={p.image} alt={p[locale].name} width="400" height="300" loading="lazy" />
      <h3>{p[locale].name}</h3>
      <p>{p[locale].desc}</p>
      <p class="price">{p.price ? `${fmt.format(p.price)} ₫` : c.contactPrice}</p>
      <a class="btn alt" href={pathFor(locale, 'contact')}>{c.ask}</a>
    </article>
  ))}
</div>
