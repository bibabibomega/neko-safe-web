---
// Hình minh họa két sắt (dùng khi chưa có ảnh thật). Thay bằng ảnh thật bằng cách điền image trong products.ts.
const { color = 'Đen', code = '', fp = false, w = 260, brand = 'NEKO' } = Astro.props as { color?: string; code?: string; fp?: boolean; w?: number; brand?: string };
const MAP: Record<string, [string, string]> = {
  'Đen': ['#2f3542', '#1f232d'], 'Trắng': ['#f4f6fa', '#d8dde7'], 'Đỏ': ['#d93a3a', '#a82727'],
  'Xanh': ['#3a8dde', '#2569b0'], 'Hồng': ['#f08cb0', '#c96a8f'], 'Nâu': ['#7b5a43', '#5a4030'],
};
const [c1, c2] = MAP[color] ?? MAP['Đen'];
const light = color === 'Trắng' || color === 'Hồng';
const txt = light ? '#2f3542' : '#ffffff';
const id = `g${Math.random().toString(36).slice(2, 8)}`;
---
<svg viewBox="0 0 260 230" width={w} role="img" aria-label={`Két sắt Neko Safe ${code}`} xmlns="http://www.w3.org/2000/svg">
  <defs><linearGradient id={id} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color={c1}/><stop offset="1" stop-color={c2}/></linearGradient></defs>
  <ellipse cx="130" cy="214" rx="104" ry="9" fill="#000" opacity=".16"/>
  <rect x="18" y="14" width="224" height="192" rx="16" fill={`url(#${id})`}/>
  <rect x="30" y="26" width="200" height="168" rx="10" fill="none" stroke={txt} stroke-opacity=".28" stroke-width="2"/>
  <rect x="48" y="206" width="22" height="8" rx="3" fill="#222"/><rect x="190" y="206" width="22" height="8" rx="3" fill="#222"/>
  <rect x="150" y="44" width="62" height="42" rx="6" fill="#0d1526"/>
  <g fill={fp ? '#4fe0a2' : '#7fd4ff'}>
    {fp
      ? <><circle cx="181" cy="65" r="11" fill="none" stroke="#4fe0a2" stroke-width="2"/><circle cx="181" cy="65" r="6" fill="none" stroke="#4fe0a2" stroke-width="2"/><circle cx="181" cy="65" r="1.8"/></>
      : <><rect x="158" y="52" width="46" height="9" rx="2"/><rect x="158" y="68" width="30" height="6" rx="2" opacity=".6"/></>}
  </g>
  <g fill={txt} fill-opacity=".85">
    {[0, 1, 2].map((r) => [0, 1, 2].map((c) => <circle cx={158 + c * 16} cy={100 + r * 16} r="4.5"/>))}
  </g>
  <circle cx="86" cy="110" r="26" fill="none" stroke={txt} stroke-opacity=".5" stroke-width="3"/>
  <circle cx="86" cy="110" r="5" fill={txt} fill-opacity=".7"/>
  <text x="130" y="178" text-anchor="middle" font-family="system-ui,Arial" font-weight="800" font-size="15" fill={txt} fill-opacity=".92" letter-spacing="1.5">{brand} {code}</text>
</svg>
